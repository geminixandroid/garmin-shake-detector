        <iq:permissions>
            <!-- Sensor is what the app actually needs: the accelerometer.
                 Communications is for the phone alert in ShakeDetectorPhone.mc.
                 Both are declared up front because adding a permission later means
                 re-installing the app with a changed permission set. -->
            <iq:uses-permission id="Communications"/>
            <iq:uses-permission id="Sensor"/>
        </iq:permissions>
        <iq:languages>
            <!-- English only: resources/strings.xml is the single string table and
                 there is no resources-<lang>/ anywhere. Declaring a language whose
