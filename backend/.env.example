# Copy to .env next to server.js and fill in.
#
# Note: the server throws on require if the VAPID keys are missing - webPush
# .setVapidDetails() fails before startup. If the log says "injected env (0) from .env",
# the file was not found or is empty, and that is the first thing to check.

PORT=3000

# Generate once:  npx web-push generate-vapid-keys
#
# NEVER change these once anyone has subscribed: a new pair invalidates every existing
# subscription, and phones silently stop receiving notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# SQLite file. Must live on persistent storage: if the platform resets the filesystem on
# deploy, subscriptions vanish while everything still looks configured.
DB_PATH=./shakedetector.db
